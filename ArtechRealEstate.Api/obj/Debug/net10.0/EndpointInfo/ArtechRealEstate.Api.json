  "components": {
    "schemas": {
      "CreateProjectDto": {
        "required": [
          "location",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "minLength": 1,
            "type": "string"
          },
          "startingPrice": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "type": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "isPublished": {
            "type": "boolean"
          },
          "coverImageUrl": {
            "type": "string",
            "nullable": true
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateProjectUnitDto"
            },
            "nullable": true
          },
          "galleryImages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateProjectGalleryImageDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateProjectGalleryImageDto": {
        "required": [
          "imageUrl"
        ],
        "type": "object",
        "properties": {
          "imageUrl": {
            "minLength": 1,
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "CreateProjectUnitDto": {
        "required": [
          "unitNumber"
        ],
        "type": "object",
        "properties": {
          "unitNumber": {
            "minLength": 1,
            "type": "string"
          },
          "areaM2": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "floor": {
            "type": "integer",
            "format": "int32"
          },
          "bedrooms": {
            "maximum": 50,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "bathrooms": {
            "maximum": 50,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "availability": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateUnitDto": {
        "required": [
          "projectId",
          "unitNumber"
        ],
        "type": "object",
        "properties": {
          "unitNumber": {
            "minLength": 1,
            "type": "string"
          },
          "areaM2": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "floor": {
            "type": "integer",
            "format": "int32"
          },
          "bedrooms": {
            "maximum": 50,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "bathrooms": {
            "maximum": 50,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "availability": {
            "$ref": "#/components/schemas/UnitAvailability"
          },
          "projectId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProjectImage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "projectId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UnitAvailability": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
